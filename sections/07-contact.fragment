<!-- ============================================================
     07. CONTACT SECTION
     - CTA liên hệ + các nút email / GitHub / Facebook
     - Không phụ thuộc JS ngoài .reveal-on-scroll.is-visible
============================================================ -->
<section class="border-b border-[#292524] relative overflow-hidden py-16" id="contact"
  style="background: linear-gradient(135deg, #FFFBF5 0%, #FFF8F0 50%, #DBEAFE/40 100%);">
  <span class="section-corner-index" aria-hidden="true">06</span>
  <!-- Decorative shapes -->
  <div
    class="absolute -top-20 left-1/4 w-[400px] h-[400px] rounded-full bg-gradient-to-br from-[#007BFF]/15 via-[#93C5FD]/8 to-transparent blur-3xl pointer-events-none"
    aria-hidden="true"></div>
  <div
    class="absolute -bottom-20 right-1/4 w-[350px] h-[350px] rounded-full bg-gradient-to-tl from-[#F59E0B]/15 via-[#F97316]/8 to-transparent blur-3xl pointer-events-none"
    aria-hidden="true"></div>

  <div class="max-w-site mx-auto px-6 relative z-10">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center reveal-on-scroll is-visible">
      <div
        class="inline-flex items-center justify-center gap-2 font-mono text-xs uppercase tracking-widest text-[#292524] font-semibold mb-4 caret animate-booted" data-anim="animate__fadeInDown">
        <span class="w-2 h-0.5 bg-[#292524] rounded-full"></span>
        LIÊN HỆ
        <span class="w-2 h-0.5 bg-[#292524] rounded-full"></span>
      </div>
      <h2
        class="section-heading-title font-display font-black text-4xl sm:text-5xl md:text-6xl text-[#007BFF] tracking-tight leading-[1.08] mb-4 animate-booted" data-anim="animate__zoomIn" data-delay="0.1">
        Bạn đang có ý tưởng, dự án hay cơ hội hợp tác mới?
      </h2>
      <p class="text-justify text-xl sm:text-2xl text-[#44403C] font-normal mb-10 animate-booted" data-anim="animate__fadeInUp" data-delay="0.2">
        Hãy cùng tạo nên những sản phẩm số giá trị.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 mb-14" data-stagger>
        <!-- Email -->
        <a class="btn-shimmer group animate-booted inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-[#007BFF] text-white font-sans font-medium text-lg hover:bg-[#0056CC] active:bg-[#0056CC] shadow-md hover:shadow-lg transition-all focus:ring-2 focus:ring-[#007BFF]"
          data-anim="animate__fadeInUp" data-delay="0"
          href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=thanhkhanhhoang801@gmail.com"
          rel="noopener noreferrer" target="_blank">
          <span class="">Gửi email</span>
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </a>

        <!-- GitHub -->
        <a class="group animate-booted inline-flex items-center gap-2 px-6 py-4 rounded-xl bg-white/80 backdrop-blur-md border border-[#E7E5E4] text-[#292524] font-sans font-medium text-base hover:bg-white hover:border-[#007BFF] hover:text-[#007BFF] transition-all shadow-sm hover:shadow-md"
          data-anim="animate__fadeInUp" data-delay="0.1" href="https://github.com/Khanhht801" rel="noopener noreferrer" target="_blank">
          <svg class="w-5 h-5 text-[#292524]" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              fill-rule="evenodd"></path>
          </svg>
          <span class="">GitHub</span>
          <span
            class="font-mono text-xs text-[#78716C] group-hover:text-[#007BFF] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>

        <!-- Facebook -->
        <a class="group animate-booted inline-flex items-center gap-2 px-6 py-4 rounded-xl bg-white/80 backdrop-blur-md border border-[#E7E5E4] text-[#292524] font-sans font-medium text-base hover:bg-white hover:border-[#007BFF] hover:text-[#007BFF] transition-all shadow-sm hover:shadow-md"
          data-anim="animate__fadeInUp" data-delay="0.2" href="https://www.facebook.com/share/1HztyqBM2J/" rel="noopener noreferrer" target="_blank">
          <svg class="w-5 h-5 text-[#1877F2]" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
          <span class="">Facebook</span>
          <span
            class="font-mono text-xs text-[#78716C] group-hover:text-[#007BFF] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>
      </div>

      <div
        class="pt-8 border-t border-[#E7E5E4] w-full flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-[#78716C] gap-2">
        <div class="flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
          <span class="">Đang mở nhận phỏng vấn cho các vị trí đợt 2026/2027</span>
        </div>
        <span class="">Múi giờ: GMT+7 (Giờ Đông Dương / Việt Nam)</span>
      </div>
    </div>
  </div>
</section>
